# FlowSpace Client Environment Configuration
# Copy this file to .env for local development with --dart-define-from-file=.env
# DO NOT commit real secrets or production keys to version control.

# Backend REST API Base URL
# - Desktop/Web: http://localhost:8000/api/v1
# - Android Emulator: http://10.0.2.2:8000/api/v1
# - Physical Mobile Phone (on same Wi-Fi): http://<YOUR_COMPUTER_LAN_IP>:8000/api/v1 (e.g. http://192.168.1.15:8000/api/v1)
# - Cloud Production: https://flowspace-api.onrender.com/api/v1
API_BASE_URL=http://localhost:8000/api/v1

# Supabase Project Configuration (Client/Anon Key Only)
# Never use the Supabase service_role key in the mobile/web client!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Environment identifier (development | staging | production)
ENVIRONMENT=development
