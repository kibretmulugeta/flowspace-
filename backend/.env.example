# FlowSpace Backend Environment Variables (FastAPI)
# Copy this file to backend/.env for local development.
# NEVER commit the real .env to version control!

# PostgreSQL Database Connection URL (from Supabase Database settings)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/flowspace

# Supabase API Settings
SUPABASE_URL=https://your-project.supabase.co
# Note: Service-role key has admin privileges and is used exclusively on the backend. Never expose to client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# JWT Token Secret for independent/hybrid session verification
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated). Use localhost in dev, custom domain in prod.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080,https://flowspace.vercel.app

# Port for local or container deployment (Render injects $PORT automatically)
PORT=8000
ENVIRONMENT=development
